# Copiar este archivo como .env y completar los valores.

# MongoDB Atlas connection string (pedir las credenciales al equipo; nunca commitearlas)
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/crm
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/crm
# Nombre de la base (opcional, por defecto crm)
# MONGO_DB_NAME=crm

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor
PORT=3000

# JWT (obligatorio). Generar uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<cambiar-por-un-valor-largo-y-aleatorio>
JWT_EXPIRES_IN=1h

# URL del frontend (CORS)
FRONTEND_URL=http://localhost:4200
