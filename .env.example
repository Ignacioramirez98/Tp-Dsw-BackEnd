# Copiar este archivo como .env y completar los valores.

# MongoDB Atlas connection string (pedir las credenciales al equipo; nunca commitearlas)
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/crm
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/crm
# Nombre de la base (opcional, por defecto crm)
# MONGO_DB_NAME=crm

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor
PORT=3000

# JWT (obligatorio). Generar uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<cambiar-por-un-valor-largo-y-aleatorio>
JWT_EXPIRES_IN=1h

# URL del frontend habilitada en CORS.
# En producción tiene que ser EXACTAMENTE la URL del front desplegado (https://, sin barra final),
# por ejemplo https://pauny-crm.vercel.app. Se pueden poner varias separadas por coma.
# No es un secreto: cualquiera que abra el front la ve.
FRONTEND_URL=http://localhost:4200

# Avisos por mail al cliente (opcional: si falta SMTP_HOST, SMTP_USER o SMTP_PASS no se mandan mails).
# Con Gmail: activar la verificación en 2 pasos y crear una "contraseña de aplicación" (ver README).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=la-cuenta@gmail.com
# SMTP_PASS=<contraseña-de-aplicación-de-16-letras>
# MAIL_FROM=Pauny CRM <la-cuenta@gmail.com>

# DNS para resolver la URL mongodb+srv de Atlas (opcional). Sin la variable, en desarrollo se usan
# 8.8.8.8 y 1.1.1.1 (evita "querySrv ECONNREFUSED" en algunas redes); "sistema" usa los DNS de la red.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Solo en Vercel: la agrega Vercel al conectar un Blob store; con ella las imágenes van a Vercel Blob.
# BLOB_READ_WRITE_TOKEN=

# Usuario administrador que crea `npm run seed` (cambiar en producción)
# Si no se definen, se usa admin / admin123
# SEED_ADMIN_USUARIO=admin
# SEED_ADMIN_PASSWORD=<una-contraseña-segura>
